                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Route details match catalog (R3)\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.drive_minutes).to.eql(90);",
                  "    pm.expect(json.price_min_inr).to.eql(10200);",
                  "    pm.expect(json.price_max_inr).to.eql(16800);",
                  "});"
